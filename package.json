    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "test": "npm run compile && node --test out/test/run.js",
    "package": "vsce package --no-dependencies",
    "app": "npm run compile && node scripts/build-app.js"
  },
  "devDependencies": {
