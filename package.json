{
  "name": "perdev",
  "displayName": "PerDev",
  "description": "A local-first AI coding agent that runs on your own model.",
  "version": "0.1.0",
  "publisher": "perdev",
  "license": "MIT",
  "icon": "media/perdev-128.png",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages",
    "Machine Learning",
    "Other"
  ],
  "main": "./out/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "perdev",
          "title": "PerDev",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "perdev": [
        {
          "type": "webview",
          "id": "perdev.chat",
          "name": "Agent"
        }
      ]
    },
    "commands": [
      {
        "command": "perdev.newProject",
        "title": "PerDev: New Project",
        "icon": "$(rocket)"
      },
      {
        "command": "perdev.newChat",
        "title": "PerDev: New Chat",
        "icon": "$(add)"
      },
      {
        "command": "perdev.stop",
        "title": "PerDev: Stop Agent",
        "icon": "$(debug-stop)"
      },
      {
        "command": "perdev.branchChat",
        "title": "PerDev: Continue in New Chat (carry a summary)",
        "icon": "$(git-branch)"
      },
      {
        "command": "perdev.history",
        "title": "PerDev: Open Previous Chat",
        "icon": "$(history)"
      },
      {
        "command": "perdev.openDataFolder",
        "title": "PerDev: Open Training Data Folder"
      },
      {
        "command": "perdev.startServers",
        "title": "PerDev: Start Local Model Servers"
      },
      {
        "command": "perdev.toggleAutocomplete",
        "title": "PerDev: Toggle Autocomplete"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "perdev.newProject",
          "when": "view == perdev.chat",
          "group": "navigation@0"
        },
        {
          "command": "perdev.newChat",
          "when": "view == perdev.chat",
          "group": "navigation"
        },
        {
          "command": "perdev.branchChat",
          "when": "view == perdev.chat",
          "group": "navigation"
        },
        {
          "command": "perdev.history",
          "when": "view == perdev.chat",
          "group": "navigation"
        },
        {
          "command": "perdev.stop",
          "when": "view == perdev.chat",
          "group": "navigation"
        }
      ]
    },
    "configuration": {
      "title": "PerDev",
      "properties": {
        "perdev.baseUrl": {
          "type": "string",
          "default": "http://127.0.0.1:8780/v1",
          "description": "OpenAI-compatible API base URL used for chat and the agent. Point it at any server that speaks /chat/completions (llama.cpp, Ollama at http://localhost:11434/v1, vLLM, LM Studio...)."
        },
        "perdev.apiKey": {
          "type": "string",
          "default": "local",
          "description": "API key sent as a Bearer token. Local servers ignore it."
        },
        "perdev.chatModel": {
          "type": "string",
          "default": "perdev-coder",
          "description": "Model used for chat and the agent."
        },
        "perdev.autocomplete.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable inline (tab) autocomplete."
        },
        "perdev.autocomplete.backend": {
          "type": "string",
          "enum": [
            "llamacpp",
            "ollama"
          ],
          "default": "llamacpp",
          "description": "Server type for autocomplete: llama.cpp (/completion) or Ollama (/api/generate)."
        },
        "perdev.autocomplete.url": {
          "type": "string",
          "default": "http://127.0.0.1:8781",
          "description": "Autocomplete server URL."
        },
        "perdev.autocomplete.model": {
          "type": "string",
          "default": "qwen2.5-coder",
          "description": "Autocomplete model name. Used to pick the fill-in-the-middle prompt format (qwen, deepseek, codestral, starcoder) and, for Ollama, which model to run."
        },
        "perdev.server.autoStart": {
          "type": "boolean",
          "default": true,
          "description": "Start local llama.cpp servers for chat and autocomplete when VS Code opens, if they aren't already running."
        },
        "perdev.server.llamaServerPath": {
          "type": "string",
          "default": "D:\\PerDev-AI\\llamacpp\\llama-server.exe",
          "description": "Path to llama-server.exe."
        },
        "perdev.server.chatModelPath": {
          "type": "string",
          "default": "D:\\PerDev-AI\\models\\Qwen2.5-Coder-7B-Instruct-Q4_K_M.gguf",
          "description": "GGUF model file for chat and the agent. Point this at your own fine-tuned model later."
        },
        "perdev.server.chatLoraPath": {
          "type": "string",
          "default": "",
          "description": "Optional LoRA adapter (GGUF) applied on top of the chat model, e.g. the perdev-lora-f16.gguf produced by training/perdev_finetune.ipynb."
        },
        "perdev.server.autocompleteModelPath": {
          "type": "string",
          "default": "D:\\PerDev-AI\\models\\Qwen2.5-Coder-1.5B.Q4_K_M.gguf",
          "description": "GGUF base model file for autocomplete."
        },
        "perdev.server.chatContext": {
          "type": "number",
          "default": 16384,
          "description": "Context window (tokens) for the chat server. Lower it if you run out of GPU memory."
        },
        "perdev.server.device": {
          "type": "string",
          "default": "Vulkan1",
          "description": "llama.cpp device to run on (see llama-server --list-devices). Vulkan1 is the RTX 3070 on this PC; empty lets llama.cpp choose."
        },
        "perdev.autocomplete.debounceMs": {
          "type": "number",
          "default": 250,
          "description": "Delay after typing before asking for a completion."
        },
        "perdev.agent.maxSteps": {
          "type": "number",
          "default": 25,
          "description": "Maximum tool-call rounds per request before the agent stops."
        },
        "perdev.agent.maxContextChars": {
          "type": "number",
          "default": 40000,
          "description": "Approximate conversation size (characters) before old tool output is trimmed. Keep it under the model's context window (~3.5 chars per token)."
        },
        "perdev.agent.suggestNewChatAt": {
          "type": "number",
          "default": 0.75,
          "minimum": 0.2,
          "maximum": 1,
          "description": "When the chat uses this share of the context budget, offer to continue in a new chat that carries a handoff summary and links back to this one."
        },
        "perdev.agent.shell": {
          "type": "string",
          "enum": [
            "auto",
            "bash",
            "powershell",
            "cmd"
          ],
          "default": "auto",
          "description": "Shell for the agent's commands. auto: Git Bash on Windows if installed (models know bash best), otherwise PowerShell."
        },
        "perdev.mcpServers": {
          "type": "object",
          "default": {},
          "markdownDescription": "MCP servers whose tools the agent can use, e.g. DroidLoop for Android:\n```json\n\"droidloop\": { \"command\": \"node\", \"args\": [\"E:/codingprojects/AndroidDevAI/dist/index.js\"], \"when\": \"android\" }\n```\nOptions per server: `when` (`always` or `android`: only in Android projects or when you mention Android), `tools` (which tools to offer; fewer works better with small models), `approve` (ask before tools that change things; default true), `readOnlyTools` (never ask for these), `env`, `enabled`.",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "command": {
                "type": "string"
              },
              "args": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "env": {
                "type": "object"
              },
              "when": {
                "type": "string",
                "enum": [
                  "always",
                  "android"
                ]
              },
              "tools": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "readOnlyTools": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "approve": {
                "type": "boolean"
              },
              "enabled": {
                "type": "boolean"
              }
            },
            "required": [
              "command"
            ]
          }
        },
        "perdev.docs.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Let the agent look things up in official documentation (via devdocs.io). Only small indexes and single pages are downloaded, and they're cached next to your chats."
        },
        "perdev.agent.approveCommands": {
          "type": "boolean",
          "default": true,
          "description": "Ask before running shell commands."
        },
        "perdev.agent.approveEdits": {
          "type": "boolean",
          "default": false,
          "description": "Ask before writing or editing files."
        },
        "perdev.dataDir": {
          "type": "string",
          "default": "",
          "description": "Folder where sessions and autocomplete feedback are logged as JSONL training data. Empty uses the extension's global storage folder."
        },
        "perdev.logTrainingData": {
          "type": "boolean",
          "default": true,
          "description": "Log agent sessions and accepted completions for fine-tuning later. Data never leaves your machine."
        },
        "perdev.startPage.show": {
          "type": "boolean",
          "default": true,
          "description": "Show the \"What are you building today?\" start screen when PerDev opens without a project."
        },
        "perdev.projectsFolder": {
          "type": "string",
          "default": "",
          "description": "Where new projects from the start screen are created. Empty: a PerDevProjects folder in your home directory."
        }
      }
    },
